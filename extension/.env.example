# RepoMind Extension Environment Configuration (Vite)
# Vite reads .env files located in the extension/ directory (or root if configured).
# Values are baked into the extension bundle at build time (import.meta.env.VITE_*).
#
# Default backend URL: http://localhost:3001
# If you configure a custom backend URL (e.g. https://api.repomind.example.com):
# 1. Update VITE_BACKEND_URL below.
# 2. Add your host origin pattern to host_permissions in extension/public/manifest.json.
# 3. Rebuild the extension bundle with: npm run build:extension (or npm --prefix extension run build).
VITE_BACKEND_URL=http://localhost:3001
