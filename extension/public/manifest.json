{
  "manifest_version": 3,
  "name": "RepoMind",
  "version": "0.1.0",
  "description": "Page-aware GitHub history assistant explaining why technical changes were made.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open RepoMind",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://github.com/*",
    "http://localhost:3001/*"
  ]
}
